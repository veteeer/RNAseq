Bootstrap: docker
From: debian:bookworm-slim

%environment
    export PATH="/opt/samtools/bin:${PATH}"

%post
    SAMTOOLS_VERSION=1.23.1
    threads=4

    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        bzip2 \
        make \
        gcc \
        perl \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libcurl4-gnutls-dev \
        libssl-dev \
        libncurses5-dev \
        libdeflate-dev
    
    curl --retry 5 --retry-delay 10 --retry-max-time 60 -fLO "https://github.com/samtools/samtools/releases/download/${SAMTOOLS_VERSION}/samtools-${SAMTOOLS_VERSION}.tar.bz2" && \
    tar -xjf samtools-${SAMTOOLS_VERSION}.tar.bz2 && rm samtools-${SAMTOOLS_VERSION}.tar.bz2

    cd samtools-${SAMTOOLS_VERSION} && \
    ./configure --prefix=/opt/samtools && \
    make -j ${threads} && make install && \
    cd .. && rm -rf samtools*

%runscript
    exec /bin/bash "$@"

%help
    Container with samtools for RNAseq pipeline.