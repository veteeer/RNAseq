Bootstrap: docker
From: debian:bookworm-slim

%environment
    export "PATH=/opt:${PATH}"

%post
    FASTP_VERSION=1.3.6

    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

    # Install fastp
    curl --retry 5 --retry-delay 10 --retry-max-time 60 -fL "http://opengene.org/fastp/fastp.${FASTP_VERSION}" -o /opt/fastp && \
    chmod 755 /opt/fastp

%runscript
    exec /bin/bash "$@"

%help
    Container with fastp tool for RNAseq pipeline.