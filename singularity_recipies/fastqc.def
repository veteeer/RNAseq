Bootstrap: docker
From: eclipse-temurin:21-jre-jammy

%environment
    export PATH="/opt/FastQC:${PATH}"

%post
    FASTQC_VERSION=0.12.1

    apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        unzip \
        perl && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

    #install fastqc
    curl --retry 5 --retry-delay 10 --retry-max-time 60 -fL "https://www.bioinformatics.babraham.ac.uk/projects/fastqc/fastqc_v${FASTQC_VERSION}.zip" -o /tmp/fastqc.zip
    unzip -q /tmp/fastqc.zip -d /opt
    rm -f /tmp/fastqc.zip
    chmod 755 /opt/FastQC/fastqc

%runscript
    exec /bin/bash "$@"

%help
    Container with fastqc tool for RNAseq pipeline.